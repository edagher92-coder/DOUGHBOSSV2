# ── Database (PostgreSQL / Supabase) ─────────────────────────────────
# Without DATABASE_URL the site still renders from the seed data in
# src/lib/data/catalogue.ts, but waitlist signups and orders are REFUSED in
# production (they are never silently dropped or faked).
DATABASE_URL=
DIRECT_URL=

# ── Payments ─────────────────────────────────────────────────────────
# Stripe Checkout Sessions. Leave blank to disable card payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Business decision: allow orders to be placed and paid in store. Off by default.
ALLOW_PAY_AT_PICKUP=0

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://doughboss.com.au

# ── Waitlist notifications ───────────────────────────────────────────
# POSTed JSON on each new signup (Zapier catch-hook, Slack incoming webhook, etc.).
WAITLIST_WEBHOOK_URL=

# ── Rate limiting (optional upgrade) ─────────────────────────────────
# In-memory limiter is per-instance. Set these to use Upstash Redis instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret salt mixed into the hash of each client IP so raw addresses are never stored.
# Generate a long random string (e.g. `openssl rand -hex 32`) and keep it out of git.
RATE_LIMIT_SALT=

# ── Demo data (NEVER in production) ──────────────────────────────────
# Loads clearly-labelled fake prices so ordering can be exercised end to end.
# The app refuses to boot with this set when NODE_ENV=production.
DOUGHBOSS_DEMO_DATA=
